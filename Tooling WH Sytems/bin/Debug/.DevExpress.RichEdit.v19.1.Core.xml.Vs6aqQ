      <summary>
        <para>Provides access to a <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> for the Rich Text Editor document’s footer which relates to the current layout object.</para>
      </summary>
      <returns>A <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> object which is the footer content.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Layout.LayoutFooter.BeginUpdate(DevExpress.XtraRichEdit.API.Native.HeaderFooterType)">
      <summary>
        <para>Provides access to a <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> for the Rich Text Editor document’s footer which relates to the current layout object.</para>
      </summary>
      <param name="type">A <see cref="T:DevExpress.XtraRichEdit.API.Native.HeaderFooterType"/> enumeration value, that is the type of the footer for which a content is obtained.</param>
      <returns>A <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> object which is the footer content.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Layout.LayoutFooter.EndUpdate(DevExpress.XtraRichEdit.API.Native.SubDocument)">
      <summary>
