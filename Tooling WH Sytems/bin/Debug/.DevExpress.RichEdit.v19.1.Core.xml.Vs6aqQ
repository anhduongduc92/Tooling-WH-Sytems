    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.Replace(DevExpress.XtraRichEdit.API.Native.DocumentRange,System.String)">
      <summary>
        <para>Replaces the specified document range with the specified text string.</para>
      </summary>
      <param name="range">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRange"/> object representing the range to replace.</param>
      <param name="text">A string that is inserted in place of the specified range.</param>
