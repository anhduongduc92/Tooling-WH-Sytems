    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetMhtText(DevExpress.XtraRichEdit.API.Native.DocumentRange,DevExpress.XtraRichEdit.Export.MhtDocumentExporterOptions)">
