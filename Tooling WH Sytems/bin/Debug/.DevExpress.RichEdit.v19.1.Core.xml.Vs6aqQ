    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.TextWrappingSide.Left">
      <summary>
        <para>The text is wrapped around the shape’s left side.</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.TextWrappingSide.Right">
      <summary>
        <para>The text is wrapped around the shape’s right side.</para>
      </summary>
    </member>
