      <param name="widthType">A <see cref="T:DevExpress.XtraRichEdit.API.Native.WidthType"/> enumeration value that specifies how the preferred width should be interpreted.</param>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.Table.Style">
