    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Layout.LayoutHeader.BeginUpdate">
      <summary>
        <para>Provides access to a <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> for the Rich Text Editor document’s header which relates to the current layout object.</para>
      </summary>
      <returns>A <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> object which is the header content.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Layout.LayoutHeader.BeginUpdate(DevExpress.XtraRichEdit.API.Native.HeaderFooterType)">
      <summary>
        <para>Provides access to a <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> for the Rich Text Editor document’s header which relates to the current layout object.</para>
      </summary>
