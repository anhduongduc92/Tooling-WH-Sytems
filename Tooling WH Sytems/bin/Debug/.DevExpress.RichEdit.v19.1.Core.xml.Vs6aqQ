        <para>Example: i, ii, iii</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.NumberingFormat.None">
      <summary>
        <para>Specifies the default numbering sequence (specifies that the sequence consists of decimal numbering).</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.NumberingFormat.NumberInDash">
      <summary>
        <para>Specifies that the sequence shall consist of Arabic numbering surrounded by dash characters.</para>
        <para>Example: - 1 -, - 2 -, - 3 -</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.NumberingFormat.Ordinal">
      <summary>
