      <param name="options">A <see cref="T:DevExpress.XtraRichEdit.Export.HtmlDocumentExporterOptions"/> instance containing various options.</param>
      <returns>A string of text in HTML format.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetHtmlText(DevExpress.XtraRichEdit.API.Native.DocumentRange,DevExpress.Office.Services.IUriProvider)">
      <summary>
        <para>Gets the text contained in the specified range in HTML format.</para>
      </summary>
      <param name="range">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRange"/> object that is the text range in the document.</param>
      <param name="provider">A class that implements the <see cref="T:DevExpress.Office.Services.IUriProvider"/> interface and provides methods which return URI for images and CSS data.</param>
      <returns>A string of text in HTML format.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetImages(DevExpress.XtraRichEdit.API.Native.DocumentRange)">
      <summary>
        <para>Gets all images (inline pictures and shapes) in the specified document range. Use a method accessible with the RichEditControl.Document.Images.Get(DocumentRange range) notation instead.</para>
      </summary>
      <param name="range">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRange"/> specifying the range in which to search for images.</param>
