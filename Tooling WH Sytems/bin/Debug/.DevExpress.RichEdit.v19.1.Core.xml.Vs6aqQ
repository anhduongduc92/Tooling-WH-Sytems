    </member>
    <member name="T:DevExpress.XtraRichEdit.API.Native.CheckBoxSizeMode">
      <summary>
        <para>Lists the size modes available for the <see cref="T:DevExpress.XtraRichEdit.API.Native.CheckBox"/> object.</para>
