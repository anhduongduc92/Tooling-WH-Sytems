      </summary>
      <value>A <see cref="T:System.Single"/> value or null, if not set.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.TablePropertiesBase.TableLayout">
      <summary>
        <para>Gets or sets the <see cref="P:DevExpress.XtraRichEdit.API.Native.Table.TableLayout"/> table property.</para>
      </summary>
      <value>A <see cref="T:DevExpress.XtraRichEdit.API.Native.TableLayoutType"/> enumeration value or null, if not set.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.TablePropertiesBase.TopPadding">
      <summary>
        <para>Gets or sets the <see cref="P:DevExpress.XtraRichEdit.API.Native.Table.TopPadding"/> table property.</para>
      </summary>
