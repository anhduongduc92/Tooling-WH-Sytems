    <member name="T:DevExpress.XtraRichEdit.API.Native.DocumentHyperlink">
      <summary>
        <para>Base class for hyperlink start and end elements.</para>
      </summary>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.DocumentHyperlink.Anchor">
      <summary>
        <para>Gets the name of a bookmark which will be the target of the DocumentHyperlink object.</para>
