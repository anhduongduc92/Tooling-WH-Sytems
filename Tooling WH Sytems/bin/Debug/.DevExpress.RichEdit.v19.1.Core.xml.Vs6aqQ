      </summary>
      <value>A <see cref="T:DevExpress.XtraRichEdit.API.Native.VerticalMergingState"/> enumeration member that specifies the state of the cell regarding the vertical merge.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.TableCell.WordWrap">
      <summary>
