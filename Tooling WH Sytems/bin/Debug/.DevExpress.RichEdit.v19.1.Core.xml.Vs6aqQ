    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.Table.Range">
      <summary>
        <para>Gets a document range occupied by a table.</para>
      </summary>
      <value>A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRange"/> occupied by a table.</value>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.Table.Reset">
      <summary>
