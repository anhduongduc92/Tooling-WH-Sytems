      <summary>
        <para>No border.</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.TableBorderLineStyle.Outset">
      <summary>
        <para>The border appears to be outset.</para>
      </summary>
    </member>
