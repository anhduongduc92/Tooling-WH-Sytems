    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.CheckBoxSizeMode.Exact">
      <summary>
        <para>The exact size specified by the <see cref="P:DevExpress.XtraRichEdit.API.Native.CheckBox.Size"/> property.</para>
      </summary>
    </member>
    <member name="T:DevExpress.XtraRichEdit.API.Native.CheckBoxState">
      <summary>
