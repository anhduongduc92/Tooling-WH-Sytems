      </summary>
      <param name="document">A <see cref="T:DevExpress.XtraRichEdit.API.Native.SubDocument"/> object which is the footer content obtained by the LayoutFooter.BeginUpdate method.</param>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Layout.LayoutFooter.Type">
      <summary>
        <para>Gets the type of layout element.</para>
      </summary>
      <value>The <see cref="F:DevExpress.XtraRichEdit.API.Layout.LayoutType.Footer"/> enumeration member.</value>
    </member>
    <member name="T:DevExpress.XtraRichEdit.API.Layout.LayoutFrame">
      <summary>
