    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetDocBytes(DevExpress.XtraRichEdit.API.Native.DocumentRange,DevExpress.XtraRichEdit.Export.DocDocumentExporterOptions)">
      <summary>
        <para>Exports the range’s content in DOC (Microsoft Word 97-2003 format) format and returns a byte array with this document.</para>
      </summary>
      <param name="range">The range to convert to DOC format.</param>
      <param name="options">An DocDocumentExporterOptions object used to specify export options.</param>
      <returns>The document content in DOC format.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetDocBytes(DevExpress.XtraRichEdit.API.Native.DocumentRange)">
      <summary>
        <para>Exports the range’s content in DOC (Microsoft Word 97-2003 format) format and returns a byte array with this document.</para>
      </summary>
      <param name="range">The range to convert to DOC format.</param>
      <returns>The document content in DOC format.</returns>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.SubDocument.GetHtmlText(DevExpress.XtraRichEdit.API.Native.DocumentRange,DevExpress.Office.Services.IUriProvider,DevExpress.XtraRichEdit.Export.HtmlDocumentExporterOptions)">
      <summary>
        <para>Gets the text contained in the specified range in HTML format.</para>
      </summary>
      <param name="range">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRange"/> object that is the text range in the document.</param>
