      </summary>
      <param name="rangePermissionEnd">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRangePermissionEnd"/> object that is being visited.</param>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.IDocumentVisitor.Visit(DevExpress.XtraRichEdit.API.Native.DocumentRangePermissionStart)">
