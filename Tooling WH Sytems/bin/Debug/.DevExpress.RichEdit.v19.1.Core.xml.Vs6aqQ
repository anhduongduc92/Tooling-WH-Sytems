      <summary>
        <para>Specifies that the sequence shall consist of the letters of the Latin alphabet in lower case.</para>
        <para>Example: a, b, c</para>
      </summary>
    </member>
    <member name="F:DevExpress.XtraRichEdit.API.Native.NumberingFormat.LowerRoman">
      <summary>
