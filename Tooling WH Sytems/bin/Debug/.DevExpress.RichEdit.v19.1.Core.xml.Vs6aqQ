      <summary>
        <para>Gets or sets the numbering list identifier.</para>
      </summary>
      <value>An integer that is the numbering list identifier.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.NumberingListBase.Levels">
