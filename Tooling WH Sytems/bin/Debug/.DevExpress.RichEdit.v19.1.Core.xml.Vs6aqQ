    <member name="P:DevExpress.XtraRichEdit.API.Native.DocumentHyperlinkEnd.Type">
      <summary>
        <para>Gets the type of a <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentHyperlinkEnd"/> object.</para>
      </summary>
      <value>A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentElementType"/> enumeration value that corresponds to the <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentHyperlinkEnd"/> object.</value>
    </member>
    <member name="T:DevExpress.XtraRichEdit.API.Native.DocumentHyperlinkStart">
      <summary>
        <para>A document element that is the hyperlink’s end accessed by DocumentIterator.</para>
      </summary>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.DocumentHyperlinkStart.Accept(DevExpress.XtraRichEdit.API.Native.IDocumentVisitor)">
