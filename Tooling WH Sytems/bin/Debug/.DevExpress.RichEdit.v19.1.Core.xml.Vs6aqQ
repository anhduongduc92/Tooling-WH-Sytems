        <para>Called when a <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentRangePermissionStart"/> element is encountered.</para>
      </summary>
      <param name="rangePermissionStart">A <see cref="T:DevExpress.XtraRichEdit.API.Native.DocumentSectionStart"/> object that is being visited.</param>
    </member>
    <member name="M:DevExpress.XtraRichEdit.API.Native.IDocumentVisitor.Visit(DevExpress.XtraRichEdit.API.Native.DocumentSectionEnd)">
