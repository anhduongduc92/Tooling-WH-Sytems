      </summary>
      <value>A <see cref="T:System.Single"/> value or null if not set.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.TablePropertiesBase.RightToLeftTableLayout">
      <summary>
        <para>Specifies whether to change the table layout’s direction to right-to-left.</para>
      </summary>
      <value>true, to change the table direction, false to keep the left-to-right direction, or null (Nothing for VB) for a mixture of states.</value>
    </member>
    <member name="P:DevExpress.XtraRichEdit.API.Native.TablePropertiesBase.TableAlignment">
      <summary>
